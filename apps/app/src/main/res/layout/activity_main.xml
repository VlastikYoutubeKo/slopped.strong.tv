<?xml version="1.0" encoding="utf-8"?>
<!-- Okraje 48/27 dp = bezpečná zóna pro overscan televize. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="27dp"
        android:paddingBottom="27dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView style="@style/Section" android:text="@string/section_system" android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout style="@style/Stat">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="RAM" android:textColor="@color/text_dim" android:textSize="18sp" />
                <TextView android:id="@+id/ram" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/ramDetail" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/text_dim" android:textSize="16sp" android:maxLines="1" />
                <ProgressBar android:id="@+id/ramBar" style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="12dp"
                    android:layout_marginTop="6dp" android:max="100" android:progressDrawable="@drawable/bar_bg" />
            </LinearLayout>

            <LinearLayout style="@style/Stat">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Úložiště" android:textColor="@color/text_dim" android:textSize="18sp" />
                <TextView android:id="@+id/storage" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/storageDetail" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/text_dim" android:textSize="16sp" android:maxLines="1" />
                <ProgressBar android:id="@+id/storageBar" style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="12dp"
                    android:layout_marginTop="6dp" android:max="100" android:progressDrawable="@drawable/bar_bg" />
            </LinearLayout>

            <LinearLayout style="@style/Stat">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CPU" android:textColor="@color/text_dim" android:textSize="18sp" />
                <TextView android:id="@+id/cpu" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/cpuDetail" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/text_dim" android:textSize="16sp" android:maxLines="1" />
            </LinearLayout>

            <LinearLayout style="@style/Stat">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Běží / síť" android:textColor="@color/text_dim" android:textSize="18sp" />
                <TextView android:id="@+id/uptime" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/ip" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/text_dim" android:textSize="16sp" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/Section" android:text="@string/section_actions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button android:id="@+id/btnFreeRam" style="@style/TvButton" android:text="@string/free_ram" />
            <Button android:id="@+id/btnAnim" style="@style/TvButton" android:text="@string/animations" />
            <Button android:id="@+id/btnApps" style="@style/TvButton" android:text="@string/apps" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="28dp"
            android:textColor="@color/ok"
            android:textSize="18sp" />

        <TextView style="@style/Section" android:text="@string/section_settings" android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button android:id="@+id/setStorage" style="@style/TvButton" android:textSize="18sp" android:text="@string/set_storage" />
            <Button android:id="@+id/setApps" style="@style/TvButton" android:textSize="18sp" android:text="@string/set_apps" />
            <Button android:id="@+id/setNetwork" style="@style/TvButton" android:textSize="18sp" android:text="@string/set_network" />
            <Button android:id="@+id/setDev" style="@style/TvButton" android:textSize="18sp" android:text="@string/set_dev" />
            <Button android:id="@+id/setHome" style="@style/TvButton" android:textSize="18sp" android:text="@string/set_home" />
            <Button android:id="@+id/setAll" style="@style/TvButton" android:textSize="18sp" android:text="@string/set_all" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="@string/hint"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
