<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF0E1116</color>
    <color name="card">#FF1B212B</color>
    <color name="card_focus">#FF2B3A55</color>
    <color name="accent">#FF4FC3F7</color>
    <color name="text">#FFF2F4F8</color>
    <color name="text_dim">#FF9AA4B2</color>
    <color name="ok">#FF66BB6A</color>
    <color name="warn">#FFFFB74D</color>
    <color name="bad">#FFEF5350</color>

    <style name="Theme.TvTools" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="TvButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">68dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Stat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/stat_bg</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>
